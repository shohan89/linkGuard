# Production environment variables for LinkGuard.
#
# Copy this to your hosting platform's environment-variable settings (or a
# local `.env.production` for reference) — never commit real values. Every
# variable here must be set on BOTH the web process (`npm start`) and the
# worker process (`npm run worker`) unless noted otherwise; they're two
# separate long-running processes that both need full config.
#
# See docs/DEPLOYMENT.md for how each of these is provisioned end to end,
# and docs/PRODUCTION_CHECKLIST.md before going live.

# ─────────────────────────────────────────────────────────────────────────
# Runtime
# ─────────────────────────────────────────────────────────────────────────

NODE_ENV=production

# ─────────────────────────────────────────────────────────────────────────
# Database (Postgres) — Supabase transaction pooler for the app, session
# pooler for migrations. Both point at the same database.
# ─────────────────────────────────────────────────────────────────────────

# Transaction-mode pooler (port 6543 on Supabase) — used by the running app
# for all normal queries. Must include ?pgbouncer=true for Prisma.
DATABASE_URL="postgresql://<user>:<password>@<host>:6543/postgres?pgbouncer=true"

# Session-mode pooler (port 5432 on Supabase) — used ONLY by `prisma migrate
# deploy` during release. Prisma Migrate needs a session-mode connection;
# it fails or misbehaves against the transaction pooler.
DIRECT_URL="postgresql://<user>:<password>@<host>:5432/postgres"

# ─────────────────────────────────────────────────────────────────────────
# Shopify
# ─────────────────────────────────────────────────────────────────────────

# Partner Dashboard → your app → Client credentials. SHOPIFY_API_SECRET
# signs/verifies every session token and webhook HMAC — treat it like a
# password (rotate via Partner Dashboard if it ever leaks).
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Must exactly match shopify.app.toml's [access_scopes].scopes — a mismatch
# here doesn't break anything by itself, but drifting values are a sign the
# two got out of sync.
SHOPIFY_SCOPES=read_products,read_content,read_online_store_pages,read_online_store_navigation,write_online_store_navigation

# The app's real production HTTPS URL — your custom domain or platform
# domain, no trailing slash. Must exactly match shopify.app.toml's
# application_url and the Partner Dashboard's App URL / redirect URL.
# NEVER a tunnel URL in production.
SHOPIFY_APP_URL=https://app.yourdomain.com

# ─────────────────────────────────────────────────────────────────────────
# Redis (BullMQ queue — background scans + the daily/weekly scheduler)
# ─────────────────────────────────────────────────────────────────────────

# rediss:// (TLS) — used by most managed Redis providers (Railway's public TCP proxy is plain redis://).
# Read by both the web process (to enqueue scans, check rate limits) and
# the worker process (to run them).
REDIS_URL="rediss://default:<password>@<host>:6379"

# ─────────────────────────────────────────────────────────────────────────
# Email (Resend) — optional but strongly recommended for production
# ─────────────────────────────────────────────────────────────────────────

# Without this, notification emails silently fail (recorded in the
# Notification table as FAILED with a clear reason) instead of sending —
# merchants get no 404/scan-complete/weekly-report emails at all.
RESEND_API_KEY=

# Must be an address on a domain verified in Resend (SPF/DKIM configured
# there) — the shared onboarding@resend.dev sender works for testing but
# has low send limits and is not appropriate for real merchant traffic.
NOTIFICATIONS_FROM_EMAIL="LinkGuard <notifications@yourdomain.com>"

# ─────────────────────────────────────────────────────────────────────────
# Not set here, but worth knowing about
# ─────────────────────────────────────────────────────────────────────────
# - PORT: most Node hosts (Render, Railway, Fly.io) inject this themselves
#   for the web process; `next start` respects it automatically.
# - There is no separate "worker URL" — the worker process (`npm run
#   worker`) doesn't listen on a port at all, it only connects out to
#   Postgres and Redis.
