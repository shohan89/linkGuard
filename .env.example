# Postgres (matches docker-compose.yml defaults). If using a pooled provider
# (e.g. Supabase), DATABASE_URL is the transaction-mode pooler and DIRECT_URL
# is the session-mode pooler used only for migrations — see prisma/schema.prisma.
DATABASE_URL="postgresql://linkguard:linkguard@localhost:5432/linkguard?schema=public"
DIRECT_URL="postgresql://linkguard:linkguard@localhost:5432/linkguard?schema=public"

# From Shopify Partner Dashboard > App > Client credentials
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Comma-separated access scopes requested at install
SHOPIFY_SCOPES=read_products,read_content,read_online_store_pages,read_online_store_navigation,write_online_store_navigation

# App URL as configured in Partner Dashboard / shopify.app.toml, no trailing slash
# In local dev this is your tunnel URL (e.g. Cloudflare/ngrok/Shopify CLI tunnel)
SHOPIFY_APP_URL=https://your-tunnel-url.example.com

NODE_ENV=development

# Redis for the background job queue (BullMQ). rediss:// (TLS) if your
# provider requires it, e.g. Upstash.
REDIS_URL="rediss://default:password@your-redis-host:6379"

# Resend (https://resend.com) for outbound notification emails. Optional —
# without it, notifications are still recorded (Notification table) but
# marked FAILED with a clear reason instead of actually sending.
RESEND_API_KEY=
# Must be a domain verified in your Resend account, or the shared
# onboarding@resend.dev sender for testing.
NOTIFICATIONS_FROM_EMAIL="LinkGuard <onboarding@resend.dev>"
